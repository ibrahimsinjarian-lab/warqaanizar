# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Admin login password (you choose this)
ADMIN_PASSWORD=your_secure_password_here

# JWT signing secret — make this long and random
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_48_characters

# Server port (default 3000)
PORT=3000

# imgBB API key — get one free at https://api.imgbb.com
# This can also be set inside the admin panel under Settings
IMGBB_API_KEY=
